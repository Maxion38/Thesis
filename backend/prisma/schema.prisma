// prisma docs: https://pris.ly/d/prisma-schema
//
// ============================================================================
// Schema V2 — généré à partir du schéma draw.io (Schéma-DB-TFE-V2-2.xml)
// et des décisions prises en review avec l'utilisateur.
//
// Correspondance FR (drawio) -> EN (prisma) :
//   utilisateur -> User                    role -> Role
//   utilisateur_role -> UserRole           sous_role -> SubRole
//   invitation -> Invitation               parcours_formation -> TrainingCourse
//   module -> Module                       outil -> Tool
//   formulaire -> Form                     question -> Question
//   option -> QuestionOption               reponse -> Response
//   soumission_formulaire -> FormSubmission
//   evenement -> Activity                  travail -> Work
//   soumission_travail -> UserWorkSubmission
//   grille_evaluation -> AssessmentGrid    critere -> Criteria
//   cellule -> Cell                        ponderation -> Weighting
//   evaluation_critere -> CriteriaAssessment
//   evaluation_grille (renommée feedback_grille) -> GridFeedback
//   projet -> Project                      groupe -> Group
//   enseignant_groupe -> UserGroup         projet_groupe -> ProjectGroup
//   intervenant_projet -> ProjectMember    preferences_rapporteur -> UserSupervisorPreference
//   condition -> Condition                 groupe_conditions -> ConditionsGroup
//   sous_groupe_conditions -> ConditionsSubgroup
//   validation_utilisateur -> UserValidation
//   notification -> Notification           carnet -> Notebook
//   lien_outil -> ToolLink
//
// Changements majeurs vs V1 (confirmés en review) :
//   - Suppression de la couche GridVersion.
//   - ProjectMember enrichi avec sousRoleId (rapporteur/president/lecteur),
//     suppression de Project.supervisorId et de User.supervisorId (hiérarchie).
//   - CriteriaAssessment.note passe en Decimal, plus de cellId stocké
//     (la cellule votée est déduite côté UI à partir de note + poids cumulés).
//   - Cell.weight (poids) ajouté pour permettre le calcul de bornes cumulées.
//   - GridFeedback.comment scindé en commentEval (interne) / commentFeedback
//     (visible étudiant).
//   - UserSupervisorPreference : ajout du champ order (ordre de préférence).
//
// Confirmations de la review V2 :
//   - Pas de conditions de "succès" : abandonnées, un élément terminé se
//     déduit directement (travail rendu, date passée, etc). ConditionsGroup
//     ne gère donc plus que les conditions d'accès -> plus de champ "type"
//     ni d'enum ConditionType.
//   - Group : pas de champ "type", le "name" est suffisant pour distinguer
//     jury / rdv école / etc.
//   - FormSubmission / UserWorkSubmission : pas de champ "status" (absent du
//     drawio V2, uniquement une date de soumission).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Utilisateurs & rôles
// ----------------------------------------------------------------------------

model User {
  id             Int       @id @default(autoincrement())
  passwordHash   String
  surname        String
  firstname      String?
  email          String    @unique
  registrationId String?   @unique // matricule
  hoursQuota     Int?
  expiresAt      DateTime?

  roles                UserRole[]
  groups               UserGroup[]
  projectMemberships   ProjectMember[]
  supervisorPreferencesAsStudent UserSupervisorPreference[] @relation("StudentPreferences")
  supervisorPreferencesAsTeacher UserSupervisorPreference[] @relation("TeacherPreferences")
  formSubmissions      FormSubmission[]
  workSubmissions      UserWorkSubmission[]
  userValidations      UserValidation[]
  notifications        Notification[]
  notebooks            Notebook[]
  validatedConditions  Condition[]           @relation("ConditionValidator")
  criteriaAssessments  CriteriaAssessment[]  @relation("CriteriaAssessmentTeacher")
  gridFeedbacks        GridFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   Int      @id @default(autoincrement())
  role RoleType @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SubRole {
  id      Int         @id @default(autoincrement())
  subRole SubRoleType @unique

  projectMembers ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id        Int      @id @default(autoincrement())
  email     String
  role      RoleType
  token     String   @unique
  used      Boolean
  expiresAt DateTime

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Parcours, modules, outils
// ----------------------------------------------------------------------------

model TrainingCourse {
  id                    Int       @id @default(autoincrement())
  name                  String
  startDate             DateTime?
  endDate               DateTime?
  supervisorAssignmentDate DateTime? // date_repartition_rapporteurs

  projects Project[]
  modules  Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id               Int     @id @default(autoincrement())
  name             String
  description      String? @db.Text
  trainingCourseId Int

  trainingCourse TrainingCourse @relation(fields: [trainingCourseId], references: [id], onDelete: Cascade)

  tools            Tool[]
  conditionsGroups ConditionsGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingCourseId])
}

// outil (supertype ISA -> Form / Activity / Work / AssessmentGrid, partagent le même id)
model Tool {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  type        ToolType
  moduleId    Int

  module Module @relation(fields: [moduleId], references: [id])

  form           Form?
  activity       Activity?
  work           Work?
  assessmentGrid AssessmentGrid?
  conditions     Condition[] @relation("ConditionTool")

  linksAsSource ToolLink[] @relation("ToolLinkSource")
  linksAsTarget ToolLink[] @relation("ToolLinkTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model ToolLink {
  sourceToolId Int
  targetToolId Int

  sourceTool Tool @relation("ToolLinkSource", fields: [sourceToolId], references: [id], onDelete: Cascade)
  targetTool Tool @relation("ToolLinkTarget", fields: [targetToolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([sourceToolId, targetToolId])
}

// ----------------------------------------------------------------------------
// Sous-types de Tool (héritage à clé partagée : id = toolId)
// ----------------------------------------------------------------------------

model Form {
  id          Int       @id
  maxAttempts Int?
  dueDate     DateTime? // date_remise

  tool        Tool             @relation(fields: [id], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id            Int       @id
  startDateTime DateTime?
  endDateTime   DateTime?
  location      String?

  tool   Tool    @relation(fields: [id], references: [id], onDelete: Cascade)
  groups Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          Int       @id
  maxAttempts Int?
  dueDate     DateTime? // date_remise

  tool        Tool                 @relation(fields: [id], references: [id], onDelete: Cascade)
  submissions UserWorkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentGrid {
  id       Int     @id
  editable Boolean // evolutif

  tool      Tool           @relation(fields: [id], references: [id], onDelete: Cascade)
  criterias Criteria[]
  feedbacks GridFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Formulaires
// ----------------------------------------------------------------------------

model Question {
  id         Int          @id @default(autoincrement())
  name       String
  type       QuestionType
  isRequired Boolean
  formId     Int

  form      Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
}

model QuestionOption {
  id         Int    @id @default(autoincrement())
  name       String
  order      Int
  questionId Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model FormSubmission {
  id          Int      @id @default(autoincrement())
  submittedAt DateTime @default(now())
  formId      Int
  userId      Int
  projectId   Int

  project   Project    @relation(fields: [projectId], references: [id])
  form      Form       @relation(fields: [formId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([formId])
}

model Response {
  id           Int    @id @default(autoincrement())
  value        String @db.Text
  questionId   Int
  submissionId Int

  question   Question       @relation(fields: [questionId], references: [id])
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([submissionId])
}

// ----------------------------------------------------------------------------
// Travaux
// ----------------------------------------------------------------------------

model UserWorkSubmission {
  id          Int      @id @default(autoincrement())
  submittedAt DateTime @default(now())
  fileName    String
  filePath    String
  workId      Int
  userId      Int
  projectId   Int

  work    Work    @relation(fields: [workId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([workId])
}

// ----------------------------------------------------------------------------
// Grille d'évaluation, critères, cellules, pondérations
// ----------------------------------------------------------------------------

model Criteria {
  id            Int    @id @default(autoincrement())
  name          String
  order         Int
  defaultWeight Int // ponderation_par_defaut
  gridId        Int

  grid                AssessmentGrid       @relation(fields: [gridId], references: [id], onDelete: Cascade)
  cells               Cell[]
  criteriaAssessments CriteriaAssessment[]
  weightings          Weighting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gridId])
}

model Cell {
  id          Int      @id @default(autoincrement())
  description String   @db.Text
  order       Int
  weight      Decimal? @db.Decimal(5, 2) // poids relatif de la cellule (défaut = pas de progression, cf. logique app)
  criteriaId  Int

  criteria Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([criteriaId])
}

// projet-specific override du poids d'un critère (dans le calcul de la note finale)
model Weighting {
  criteriaId Int
  projectId  Int
  weight     Decimal @db.Decimal(5, 2)

  criteria Criteria @relation(fields: [criteriaId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@id([criteriaId, projectId])
}

// note par critère : la cellule votée est déduite en front à partir de
// `note` et des `weight` cumulés des cellules du critère (pas de FK stockée).
model CriteriaAssessment {
  id               Int      @id @default(autoincrement())
  date             DateTime
  commentEval      String?  @db.Text // commentaire visible profs uniquement
  commentFeedback  String?  @db.Text // commentaire visible étudiants (+ profs)
  note             Decimal? @db.Decimal(5, 2)
  criteriaId       Int
  teacherId        Int
  projectId        Int

  criteria Criteria @relation(fields: [criteriaId], references: [id])
  teacher  User     @relation("CriteriaAssessmentTeacher", fields: [teacherId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([teacherId])
  @@index([criteriaId])
}

// feedback global déposé sur la grille (indépendant des CriteriaAssessment)
model GridFeedback {
  id              Int     @id @default(autoincrement())
  commentEval     String? @db.Text
  commentFeedback String? @db.Text
  userId          Int
  projectId       Int
  gridId          Int

  user    User           @relation(fields: [userId], references: [id])
  project Project        @relation(fields: [projectId], references: [id])
  grid    AssessmentGrid @relation(fields: [gridId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([gridId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Projets, groupes (jurys / rdv), intervenants
// ----------------------------------------------------------------------------

model Project {
  id               Int     @id @default(autoincrement())
  title            String?
  confidential     Boolean @default(false)
  trainingCourseId Int

  trainingCourse TrainingCourse @relation(fields: [trainingCourseId], references: [id])

  members               ProjectMember[]
  projectGroups         ProjectGroup[]
  notebooks             Notebook[]
  formSubmissions       FormSubmission[]
  workSubmissions       UserWorkSubmission[]
  criteriaAssessments   CriteriaAssessment[]
  weightings            Weighting[]
  gridFeedbacks         GridFeedback[]
  supervisorPreferences UserSupervisorPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingCourseId])
}

// intervenant_projet : membre d'un projet, avec sous-rôle optionnel (jury)
model ProjectMember {
  userId    Int
  projectId Int
  subRoleId Int?

  user    User     @relation(fields: [userId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  subRole SubRole? @relation(fields: [subRoleId], references: [id])

  @@id([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@index([subRoleId])
}

// preferences_rapporteur : ordre de préférence d'un étudiant pour un enseignant
model UserSupervisorPreference {
  userId    Int
  teacherId Int
  projectId Int
  order     Int

  user    User    @relation("StudentPreferences", fields: [userId], references: [id])
  teacher User    @relation("TeacherPreferences", fields: [teacherId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([userId, teacherId, projectId])
}

// groupe : conteneur générique (jury, rdv ephec...) rattaché à un évènement
model Group {
  id            Int       @id @default(autoincrement())
  name          String
  startDateTime DateTime?
  endDateTime   DateTime?
  location      String?
  eventId       Int

  event    Activity        @relation(fields: [eventId], references: [id])
  users    UserGroup[]
  projects ProjectGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// enseignant_groupe : enseignants assignés à un groupe
model UserGroup {
  userId  Int
  groupId Int

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

// projet_groupe : projets assignés à un groupe (jury)
model ProjectGroup {
  groupId   Int
  projectId Int

  group   Group   @relation(fields: [groupId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([groupId, projectId])
}

// ----------------------------------------------------------------------------
// Conditions de validation de module
// ----------------------------------------------------------------------------

model ConditionsGroup {
  id       Int               @id @default(autoincrement())
  operator ConditionOperator
  moduleId Int

  module Module @relation(fields: [moduleId], references: [id])

  subgroups ConditionsSubgroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model ConditionsSubgroup {
  id                Int               @id @default(autoincrement())
  operator          ConditionOperator
  conditionsGroupId Int

  conditionsGroup ConditionsGroup @relation(fields: [conditionsGroupId], references: [id])
  conditions      Condition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conditionsGroupId])
}

model Condition {
  id                   Int             @id @default(autoincrement())
  method               ConditionMethod
  dateValue            DateTime?
  validatorId          Int? // utilisateur_id (valideur)
  toolId               Int?
  conditionsSubgroupId Int

  validator          User?              @relation("ConditionValidator", fields: [validatorId], references: [id])
  tool               Tool?              @relation("ConditionTool", fields: [toolId], references: [id])
  userValidations    UserValidation[]
  conditionsSubgroup ConditionsSubgroup @relation(fields: [conditionsSubgroupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toolId])
  @@index([validatorId])
  @@index([conditionsSubgroupId])
}

model UserValidation {
  userId      Int
  conditionId Int
  date        DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  condition Condition @relation(fields: [conditionId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, conditionId])
}

// ----------------------------------------------------------------------------
// Notifications & carnet
// ----------------------------------------------------------------------------

model Notification {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  importance  Importance
  date        DateTime   @default(now())
  read        Boolean    @default(false)
  sourceType  String? // type_entite_emettrice (parcours / evaluation / soumission / ...)
  sourceId    Int? // entite_emettrice_id
  userId      Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notebook {
  userId       Int
  projectId    Int
  content      String?  @db.Text
  lastModified DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, projectId])
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum RoleType {
  STUDENT
  TEACHER
  COORDINATOR
  EXTERNAL
}

enum SubRoleType {
  SUPERVISOR
  PRESIDENT
  READER
}

enum Importance {
  LOW
  MEDIUM
  HIGH
}

enum ConditionMethod {
  USER_VALIDATION
  SUPERVISOR_VALIDATION
  TOOL_SUBMISSION
  DATE
}

enum ConditionOperator {
  AND
  OR
}

enum ToolType {
  FORM
  ACTIVITY
  WORK
  ASSESSMENT
}

enum QuestionType {
  TEXT
  CHECKBOX
  SELECT
}
