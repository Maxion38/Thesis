// prisma docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  passwordHash String
  surname      String
  firstname    String?
  email        String  @unique
  hoursQuota   Int?
  supervisorId Int?
  // todo : add username (matricule)

  supervisorPreferencesAsStudent UserSupervisorPreference[] @relation("StudentPreferences")
  supervisorPreferencesAsTeacher UserSupervisorPreference[] @relation("TeacherPreferences")
  projectMemberships             ProjectMember[]
  supervisedProjects             Project[]                  @relation("ProjectSupervisor")
  supervisor                     User?                      @relation("UserSupervisor", fields: [supervisorId], references: [id])
  subordinates                   User[]                     @relation("UserSupervisor")
  roles                          UserRole[]
  groups                         UserGroup[]
  formSubmissions                FormSubmission[]
  submissions                    UserWorkSubmission[]
  userValidation                 UserValidation[]
  notifications                  Notification[]
  criteriaAssessmentsAsStudent   CriteriaAssessment[]       @relation("CriteriaAssessmentStudent")
  criteriaAssessmentsAsTeacher   CriteriaAssessment[]       @relation("CriteriaAssessmentTeacher")
  gridVersionFeedbacks           GridVersionFeedback[]
  notebooks                      Notebook[]
  validatedConditions            Condition[]                @relation("ConditionValidator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id Int @id @default(autoincrement())

  role RoleType @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSupervisorPreference {
  userId    Int
  teacherId Int
  projectId Int

  user    User    @relation("StudentPreferences", fields: [userId], references: [id])
  teacher User    @relation("TeacherPreferences", fields: [teacherId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([userId, teacherId, projectId])
}

model Invitation {
  id        Int      @id @default(autoincrement())
  email     String
  role      RoleType
  token     String   @unique
  used      Boolean
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model TrainingCourse {
  id        Int       @id @default(autoincrement())
  name      String
  startDate DateTime?
  endDate   DateTime?

  projects Project[]
  modules  Module[]  @relation("ModuleTrainingCourse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id               Int     @id @default(autoincrement())
  name             String
  description      String? @db.Text
  trainingCourseId Int

  trainingCourse TrainingCourse @relation("ModuleTrainingCourse", fields: [trainingCourseId], references: [id], onDelete: Cascade)

  tools            Tool[]            @relation("ToolModule")
  conditionsGroups ConditionsGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingCourseId])
}

model Condition {
  id                   Int             @id @default(autoincrement())
  method               ConditionMethod
  dateValue            DateTime?
  validatorId          Int?
  toolId               Int?
  conditionsSubgroupId Int

  validator          User?              @relation("ConditionValidator", fields: [validatorId], references: [id])
  tool               Tool?              @relation("ConditionTool", fields: [toolId], references: [id])
  userValidations    UserValidation[]
  conditionsSubgroup ConditionsSubgroup @relation(fields: [conditionsSubgroupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toolId])
  @@index([validatorId])
}

model UserValidation {
  userId      Int
  conditionId Int

  user      User      @relation(fields: [userId], references: [id])
  condition Condition @relation(fields: [conditionId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, conditionId])
}

model Tool {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  type        ToolType
  moduleId    Int

  module Module @relation("ToolModule", fields: [moduleId], references: [id])

  forms           Form[]
  activities      Activity[]
  works           Work[]
  assessmentGrids AssessmentGrid[]
  conditions      Condition[]      @relation("ConditionTool")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Form {
  id          Int @id @default(autoincrement())
  maxAttempts Int
  toolId      Int

  tool        Tool             @relation(fields: [toolId], references: [id])
  questions   Question[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id         Int          @id @default(autoincrement())
  name       String
  type       QuestionType
  isRequired Boolean
  formId     Int

  form      Form             @relation(fields: [formId], references: [id])
  options   QuestionOption[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionOption {
  id         Int    @id @default(autoincrement())
  name       String
  order      Int
  questionId Int

  question Question @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id          Int              @id @default(autoincrement())
  submittedAt DateTime         @default(now())
  status      SubmissionStatus
  formId      Int
  userId      Int
  projectId   Int

  project   Project    @relation(fields: [projectId], references: [id])
  form      Form       @relation(fields: [formId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

model Response {
  id           Int    @id @default(autoincrement())
  value        String
  questionId   Int
  submissionId Int

  question   Question       @relation(fields: [questionId], references: [id])
  submission FormSubmission @relation(fields: [submissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id            Int       @id @default(autoincrement())
  startDateTime DateTime?
  endDateTime   DateTime?
  location      String?

  toolId Int
  tool   Tool @relation(fields: [toolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          Int @id @default(autoincrement())
  toolId      Int
  maxAttempts Int

  tool                Tool                 @relation(fields: [toolId], references: [id])
  userWorkSubmissions UserWorkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserWorkSubmission {
  id          Int      @id @default(autoincrement())
  submittedAt DateTime @default(now())
  fileName    String
  filePath    String
  workId      Int
  userId      Int
  projectId   Int

  work    Work    @relation(fields: [workId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

model AssessmentGrid {
  id     Int @id @default(autoincrement())
  toolId Int

  tool         Tool          @relation(fields: [toolId], references: [id])
  gridVersions GridVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GridVersion {
  id               Int       @id @default(autoincrement())
  startDate        DateTime?
  endDate          DateTime?
  assessmentGridId Int

  assessmentGrid AssessmentGrid        @relation(fields: [assessmentGridId], references: [id])
  criterias      Criteria[]
  feedbacks      GridVersionFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CriteriaAssessment {
  id         Int      @id @default(autoincrement())
  date       DateTime
  comment    String?  @db.Text
  cellId     Int
  projectId  Int
  criteriaId Int
  studentId  Int?
  teacherId  Int

  cell     Cell     @relation(fields: [cellId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  criteria Criteria @relation(fields: [criteriaId], references: [id])
  student  User?    @relation("CriteriaAssessmentStudent", fields: [studentId], references: [id])
  teacher  User     @relation("CriteriaAssessmentTeacher", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([studentId])
  @@index([teacherId])
  @@index([criteriaId])
}

model Criteria {
  id            Int    @id @default(autoincrement())
  name          String
  order         Int
  defaultWeight Int
  gridVersionId Int

  gridVersion         GridVersion          @relation(fields: [gridVersionId], references: [id])
  cells               Cell[]
  criteriaAssessments CriteriaAssessment[]
  weightings          Weighting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cell {
  id          Int    @id @default(autoincrement())
  description String @db.Text
  order       Int
  criteriaId  Int

  criteria            Criteria             @relation(fields: [criteriaId], references: [id])
  criteriaAssessments CriteriaAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Weighting {
  criteriaId Int
  projectId  Int
  weight     Float

  criteria Criteria @relation(fields: [criteriaId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@id([criteriaId, projectId])
}

model GridVersionFeedback {
  id            Int    @id @default(autoincrement())
  comment       String @db.Text
  userId        Int
  projectId     Int
  gridVersionId Int

  user        User        @relation(fields: [userId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id])
  gridVersion GridVersion @relation(fields: [gridVersionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([gridVersionId])
}

model Project {
  id Int @id @default(autoincrement())

  title String

  supervisorId     Int?
  trainingCourseId Int

  supervisor          User?                 @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  trainingCourse      TrainingCourse        @relation(fields: [trainingCourseId], references: [id])
  members             ProjectMember[]
  notebooks           Notebook[]
  formSubmissions     FormSubmission[]
  workSubmissions     UserWorkSubmission[]
  criteriaAssessments CriteriaAssessment[]
  weightings          Weighting[]
  feedbacks           GridVersionFeedback[]

  supervisorPreferences UserSupervisorPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  userId    Int
  projectId Int

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

model ConditionsGroup {
  id Int @id @default(autoincrement())

  type ConditionType

  operator ConditionOperator

  moduleId Int

  module Module @relation(fields: [moduleId], references: [id])

  subgroups ConditionsSubgroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConditionsSubgroup {
  id Int @id @default(autoincrement())

  operator ConditionOperator

  conditionsGroupId Int

  conditionsGroup ConditionsGroup @relation(fields: [conditionsGroupId], references: [id])

  conditions Condition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id            Int       @id @default(autoincrement())
  name          String
  type          String
  startDateTime DateTime?
  endDateTime   DateTime?
  location      String?

  users UserGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserGroup {
  userId  Int
  groupId Int

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

model Notification {
  id          Int        @id @default(autoincrement())
  name        String
  description String     @db.Text
  importance  Importance
  dateTime    DateTime   @default(now())
  userId      Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notebook {
  userId       Int
  projectId    Int
  content      String?  @db.Text
  lastModified DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, projectId])
}

enum RoleType {
  STUDENT
  TEACHER
  COORDINATOR
  GUEST
}

enum Importance {
  LOW
  MEDIUM
  HIGH
}

enum ConditionType {
  ACCESS
  SUCCESS
}

enum ConditionMethod {
  USER_VALIDATION
  SUPERVISOR_VALIDATION
  TOOL_SUBMISSION
  DATE
}

enum ConditionOperator {
  AND
  OR
}

enum ToolType {
  FORM
  ACTIVITY
  WORK
  ASSESSMENT
}

enum QuestionType {
  TEXT
  NUMBER
  RADIO
  CHECKBOX
}

enum SubmissionStatus {
  NOT_SUBMITED
  SUBMITTED
  APPROVED
}
