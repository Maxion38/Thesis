# Connexion à la DB dev (lancée via docker-compose.dev.yml)
DATABASE_URL="postgresql://thesis_user:dev_password@localhost:5432/thesis_db"

# Brevo (https://www.brevo.com) — optionnel en dev, requis pour tester l'envoi d'emails et donc la feature invitations
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thesis

# Stockage des remises de travaux (chemin relatif depuis backend/)
STORAGE_PATH=../storage

# JWT — peut être une valeur arbitraire en dev
JWT_SECRET=dev_secret