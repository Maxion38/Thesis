{
  "name": "thesis",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:db": "docker compose -f docker-compose.dev.yml up",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:studio": "cd backend && npx prisma studio",
    "dev:frontend": "cd frontend && npx ng serve --open",
    "dev": "concurrently -k -n DB,BACKEND,STUDIO,FRONTEND -c blue,green,yellow,magenta \"npm:dev:db\" \"npm:dev:backend\" \"npm:dev:studio\" \"npm:dev:frontend\"",
    "prod": "docker compose up -d --build",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxion38/Thesis.git"
  },
